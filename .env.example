# ==============================================================================
# CONFIGURATION VAULTWARDEN (KAPKALI)
# ==============================================================================

# Nom de domaine complet avec le protocole HTTPS (ex: https://coffre-fort.kapkali.com)
DOMAIN=https://coffre-fort.kapkali.com

# Gestion des inscriptions :
# 1. Laissez 'true' lors du TOUT PREMIER lancement pour créer votre compte administrateur.
# 2. Une fois votre compte créé, passez impérativement à 'false' pour verrouiller le coffre-fort.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false

# Synchronisation WebSocket (temps réel pour les extensions navigateur et mobiles)
ENABLE_WEBSOCKET=true

# Token d'administration (/admin).
# Laisser vide pour désactiver la page /admin (recommandé pour une sécurité maximale).
# ADMIN_TOKEN=

# Nom du conteneur et du volume de stockage
CONTAINER_NAME=vaultwarden
DATA_VOLUME=vw_data

# Nom du réseau Docker externe Caddy (par défaut: web-network)
WEB_NETWORK=web-network

# ==============================================================================
# TITRE ET MARQUE (Templatisables par client)
# ==============================================================================
# Titre principal affiché sur la page d'accueil (ex: Gestionnaire MDP | MonClient)
APP_NAME=Gestionnaire MDP | MonClient
# Nom court remplaçant 'Bitwarden' sur les sous-pages (ex: Coffres - MonClient)
BRAND_SHORT=MonClient

# ==============================================================================
# CHARTE GRAPHIQUE & COULEURS (Templatisables par client)
# ==============================================================================
# Couleur d'action principale : Boutons CTA, liens au survol, badges, focus
COLOR_PRIMARY=#FF7F00
COLOR_PRIMARY_HOVER=#E06F00

# Couleur de structure : Grands titres (h1, h2) et en-tête de navigation
COLOR_HEADER=#110979

# Fond sombre et éléments de structure (Footer)
COLOR_DARK=#0B0654

# Fond neutre clair (sections alternées)
COLOR_LIGHT=#F4F4F5

# Fond blanc pur (conteneurs, cartes)
COLOR_WHITE=#FFFFFF

# ==============================================================================
# LOGOS TEMPLATISABLES (dans custom/branding/)
# ==============================================================================
# Nom du fichier du logo principal horizontal (par défaut: logo.svg)
LOGO_MAIN=logo.svg
# Nom du fichier de l'icône carrée / splash screen (par défaut: logo-icon.svg)
LOGO_ICON=logo-icon.svg
