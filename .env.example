# ==============================================================================
# CONFIGURATION VAULTWARDEN (KAPKALI)
# ==============================================================================

# Nom de domaine complet avec le protocole HTTPS (ex: https://coffre-fort.kapkali.com)
DOMAIN=

# Gestion des accès et inscriptions :
# 1. Laissez 'true' lors du TOUT PREMIER lancement pour créer votre compte administrateur.
# 2. Une fois votre compte créé, passez impérativement à 'false' pour verrouiller le coffre-fort.
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false

# Synchronisation WebSocket (temps réel pour les extensions navigateur et mobiles)
ENABLE_WEBSOCKET=true

# Token d'accès au panneau d'administration (/admin).
# Si vide : le panneau /admin est TOTALEMENT DÉSACTIVÉ (recommandé pour une sécurité maximale).
# Si vous voulez l'activer, générez une clé chiffrée Argon2 via :
# docker run --rm -it vaultwarden/server:latest /vaultwarden hash
# ADMIN_TOKEN=

# Nom du conteneur et du volume de stockage
CONTAINER_NAME=vaultwarden
DATA_VOLUME=vw_data

# Nom du réseau Docker externe Caddy (par défaut: web-network)
WEB_NETWORK=web-network
